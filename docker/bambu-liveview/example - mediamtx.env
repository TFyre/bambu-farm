# Copy to `mediamtx.env` and fix the values.
#
# Hand-maintained mediamtx overrides. mediamtx loads these AFTER mediamtx.yml,
# so anything set here wins over the stock file. That is what lets mediamtx.yml
# stay a verbatim copy of upstream's file, replaceable on every version bump.
#
# Env vars are read only at startup: changing this file needs
# `docker compose up -d`, not the hot reload that mediamtx.yml gets.
#
# Per-printer paths are NOT here - build-printers-env.sh generates those into
# printers.env.

###############################################
# WebRTC
#
# These three are what make the browser reach mediamtx. Without them WebRTC
# advertises the container's internal IPs, which no browser can connect to.

# Bind WebRTC to a fixed TCP port so it can be reached through the docker port
# mapping. Upstream default is ''.
MTX_WEBRTCLOCALTCPADDRESS=:8189

# Do not advertise the docker container's internal IPs as ICE candidates - they
# are unreachable from browsers on the LAN. Upstream default is yes.
MTX_WEBRTCIPSFROMINTERFACES=no

# The address browsers should actually use to reach mediamtx: the docker host's
# IP, or its DNS name. Comma separated if there is more than one.
# Upstream default is [].
MTX_WEBRTCADDITIONALHOSTS=FIXME_this_is_my_docker_host_ip

###############################################
# Source behaviour

# Pull printers over TCP rather than UDP. UDP has no read timeout, so a stalled
# printer is undetectable there and the stream hangs silently.
#
# This one IS safe in pathDefaults: mediamtx only validates it against the path
# it ends up on, and every printer path overrides 'source' with an rtsps:// URL.
MTX_PATHDEFAULTS_RTSPTRANSPORT=tcp

# sourceOnDemand deliberately NOT set here.
#
# pathDefaults.source is 'publisher', and mediamtx rejects that combination at
# startup:
#   ERR: 'sourceOnDemand' is useless when source is 'publisher'
#
# So the stock default (false) stays, meaning mediamtx connects to every printer
# at startup and holds the connection, reconnecting on its own when a printer
# drops.
#
# To only connect while someone is watching, set it per path instead - either in
# printers.env, or in build-printers-env.sh so it survives regeneration:
#   MTX_PATHS_MYPRINTER_SOURCEONDEMAND=yes
# mediamtx then drops the source 10s after the last viewer leaves.
